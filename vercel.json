{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
